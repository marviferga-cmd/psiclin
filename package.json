{
  "name": "psiclin",
  "version": "1.0.0",
  "private": true,
  "description": "PsiClin - Sistema de gestão para clínicas de psicologia",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "prisma migrate deploy && (node prisma/seed.mjs || echo \"seed falhou\") && next start",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node prisma/seed.mjs",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.21",
    "bcryptjs": "^3.0.2",
    "date-fns": "^3.6.0",
    "jose": "^6.0.11",
    "lucide-react": "^0.577.0",
    "next": "15.5.28",
    "postcss": "^8.5.6",
    "prisma": "7.10.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.8.3",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
